---
import { getCollection } from "astro:content";

import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import FormattedDate from "../../components/FormattedDate.astro";

const entries = (await getCollection("learning")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const [today, ...archive] = entries;

const kindLabel = {
  paper: "Research paper",
  component: "System design component",
  pattern: "Pattern",
};

const totalTopics = entries.reduce(
  (sum, e) => sum + e.data.mastery.reduce((n, s) => n + s.topics.length, 0),
  0
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Learning of the Day"
      description="One system design component or research paper, summarised every day — with the sources to read and the full path to mastering it."
    />
  </head>

  <body class="bg-neutral-950 text-neutral-200">
    <Header />

    <main class="max-w-6xl mx-auto px-6 py-16">
      <header class="mb-14 max-w-3xl">
        <h1 class="text-4xl font-bold">Learning of the Day</h1>
        <p class="mt-4 text-neutral-400 text-lg leading-relaxed">
          One thing a day — a system design component, a pattern, or a research
          paper. Each entry is a summary, the rule for when to reach for it, the
          sources worth reading, and every topic you'd need to actually master
          it.
        </p>

        <div class="mt-6 flex flex-wrap gap-6 text-sm text-neutral-500">
          <span><strong class="text-neutral-300">{entries.length}</strong> entries</span>
          <span><strong class="text-neutral-300">{totalTopics}</strong> topics mapped</span>
        </div>
      </header>

      {
        today && (
          <section class="mb-20">
            <h2 class="text-xs uppercase tracking-widest text-blue-400 mb-4">
              Latest
            </h2>

            <a
              href={`/learning/${today.id}/`}
              class="group block rounded-2xl border border-neutral-800 bg-neutral-900/40 p-8 hover:border-neutral-600 transition"
            >
              <div class="flex flex-wrap items-center gap-3 text-sm text-neutral-500 mb-4">
                <FormattedDate date={today.data.pubDate} />
                <span class="text-neutral-700">/</span>
                <span>{kindLabel[today.data.kind]}</span>
              </div>

              <h3 class="text-2xl md:text-3xl font-bold text-neutral-100 group-hover:text-white transition">
                {today.data.title}
              </h3>

              <p class="mt-4 text-neutral-400 leading-relaxed max-w-3xl">
                {today.data.tldr}
              </p>

              <div class="mt-6 flex flex-wrap gap-2">
                {today.data.tags.map((tag) => (
                  <span class="px-2 py-1 text-xs bg-neutral-800 border border-neutral-700 rounded-md">
                    {tag}
                  </span>
                ))}
              </div>

              <div class="mt-6 flex flex-wrap gap-6 text-sm text-neutral-500">
                <span>
                  {today.data.sources.length} sources
                </span>
                <span>
                  {today.data.mastery.reduce((n, s) => n + s.topics.length, 0)}{" "}
                  topics to master
                </span>
                <span class="text-blue-400 group-hover:translate-x-1 transition-transform inline-block">
                  Read →
                </span>
              </div>
            </a>
          </section>
        )
      }

      {
        archive.length > 0 && (
          <section>
            <h2 class="text-xs uppercase tracking-widest text-neutral-500 mb-6">
              Archive
            </h2>

            <ul class="divide-y divide-neutral-900 border-t border-neutral-900">
              {archive.map((entry) => (
                <li>
                  <a
                    href={`/learning/${entry.id}/`}
                    class="group flex flex-col md:flex-row md:items-baseline gap-2 md:gap-6 py-5 hover:bg-neutral-900/40 transition px-2 -mx-2 rounded"
                  >
                    <time class="text-sm text-neutral-500 shrink-0 md:w-32">
                      <FormattedDate date={entry.data.pubDate} />
                    </time>

                    <div class="min-w-0">
                      <h3 class="font-semibold text-neutral-200 group-hover:text-white transition">
                        {entry.data.title}
                      </h3>
                      <p class="mt-1 text-sm text-neutral-500 line-clamp-2">
                        {entry.data.description}
                      </p>
                    </div>

                    <span class="ml-auto shrink-0 text-xs text-neutral-600 hidden md:block">
                      {kindLabel[entry.data.kind]}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        entries.length === 0 && (
          <p class="text-neutral-500">
            Nothing here yet — the first entry lands tomorrow morning.
          </p>
        )
      }
    </main>

    <Footer />
  </body>
</html>
